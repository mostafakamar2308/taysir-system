generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================General Data=================

model Speciality {
  id    Int    @id @default(autoincrement())
  title String

  tutor Tutor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Currency {
  id Int @id @default(autoincrement())

  code   String @unique // ISO code: USD, SAR, EGP 
  name   String // US Dollar, Saudi Riyal, Egyptian Pound
  symbol String // $, ﷼, £

  students  Student[]
  tutors    Tutor[]
  payments  Revenue[]
  expenses  Expense[]
  academies Academy[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  plans                Plan[]
  subscriptions        Subscription[]
  academyCurrencyRates AcademyCurrencyRate[]

  @@index([code])
}

model SaasPlan {
  id            Int       @id @default(autoincrement())
  name          String
  dollarPrice   Float
  egyptianPrice Float
  maxStudents   Int
  maxTutors     Int
  billingPeriod Int
  features      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  academies     Academy[]
}

// ===================Academy Data=================

model Academy {
  id                Int       @id @default(autoincrement())
  name              String
  maxTutors         Int
  maxStudents       Int
  primaryColor      String
  defaultCurrencyId Int?
  defaultCurrency   Currency? @relation(fields: [defaultCurrencyId], references: [id])
  saasPlan          SaasPlan? @relation(fields: [saasPlanId], references: [id])
  saasPlanId        Int?
  saasPlanStartDate DateTime?
  saasPlanEndDate   DateTime?

  whatsappInstanceName     String?   @unique
  whatsappInstanceToken    String?
  whatsappConnectionStatus String?   @default("disconnected")
  whatsappConnectedAt      DateTime?
  whatsappDisconnectedAt   DateTime?
  whatsappWebhookUrl       String?

  admin                Admin?
  adminId              Int?
  supervisors          Supervisor[]
  tutors               Tutor[]
  students             Student[]
  groups               Group[]
  sessions             Session[]
  expenses             Expense[]
  plans                Plan[]
  histories            History[]
  revenues             Revenue[]
  academyCurrencyRates AcademyCurrencyRate[]
  whatsAppMessages     WhatsAppMessage[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  chatRooms        ChatRoom[]
  groupChatRooms   GroupChatRoom[]
  academySettings  AcademySettings?
}

model AcademySettings {
  id        Int     @id @default(autoincrement())
  academyId Int     @unique
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  // Whether tutors may create sessions for their groups/students.
  tutorsCanCreateSessions Boolean @default(true)
  // Whether tutors may change the time (startTime/duration) of existing sessions.
  tutorsCanEditSessionTime Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academyId])
}

model AcademyCurrencyRate {
  id         Int      @id @default(autoincrement())
  academyId  Int
  academy    Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  currencyId Int
  currency   Currency @relation(fields: [currencyId], references: [id])
  rate       Float // conversion rate to academy's default currency (1 unit of this currency = rate units of default currency)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([academyId, currencyId])
  @@index([academyId])
}

// ===================USERS=================
model User {
  id                Int     @id @default(autoincrement())
  email             String  @unique
  password          String
  name              String?
  role              Int
  timezone          String  @default("Africa/Cairo")
  phone             String?
  preferredLanguage String  @default("ar")
  imageUrl          String?

  superAdmin        SuperAdmin?
  admin             Admin?
  supervisor        Supervisor?
  student           Student?
  tutor             Tutor?
  notes             Note[]
  revenues          Revenue[]
  expenses          Expense[]
  chatMessages      ChatMessage[]
  tutorChatRooms    ChatRoom[]         @relation("TutorChatRooms")
  studentChatRooms  ChatRoom[]         @relation("StudentChatRooms")
  groupChatMemberships GroupChatMember[]
  groupChatMessages    GroupChatMessage[]
  pushSubscriptions PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  academyId Int     @unique
  academy   Academy @relation(fields: [academyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Student {
  id            Int      @id @default(autoincrement())
  age           Int      @default(12)
  country       String?
  status        Int      @default(0)
  currencyId    Int
  currency      Currency @relation(fields: [currencyId], references: [id])
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditBalance Float    @default(0)
  source        String?

  // Custom billing date override (null = derived from active subscriptions).
  // Once set by an admin it persists until explicitly cleared.
  billingDate DateTime?

  academyId Int
  academy   Academy @relation(fields: [academyId], references: [id])

  groupMemberships      GroupStudent[]
  studentAvailabilities StudentAvailability[]
  notes                 Note[]
  payments              Revenue[]
  sessionParticipants   SessionParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Supervisor {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  active    Boolean  @default(true)
  academyId Int
  academy   Academy @relation(fields: [academyId], references: [id])

  defaultForTutors Tutor[]           @relation("TutorDefaultSupervisor")
  sessions         Session[]
  tutorAttendances TutorAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Tutor {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  academyId  Int
  academy    Academy  @relation(fields: [academyId], references: [id])
  currency   Currency @relation(fields: [currencyId], references: [id])
  currencyId Int

  baseHourlyRate      Float     @default(0)
  baseGroupHourlyRate Float     @default(0)
  active              Boolean?
  bio                 String?
  qualifications      String?
  imageUrl            String?
  zoomAuthenticated   Boolean   @default(false)
  zoomUrl             String?
  zoomAccessToken     String?
  zoomRefreshToken    String?
  zoomTokenExpiry     DateTime?
  zoomUserId          String?

  defaultSupervisorId Int?
  defaultSupervisor   Supervisor? @relation("TutorDefaultSupervisor", fields: [defaultSupervisorId], references: [id])

  specialities        Speciality[]
  groups              Group[]
  tutorAvailabilities TutorAvailability[]
  notes               Note[]
  expenses            Expense[]
  sessions            Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([defaultSupervisorId])
}

model SuperAdmin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ===================Groups=================

model Group {
  id             Int     @id @default(autoincrement())
  title          String
  academyId      Int
  academy        Academy @relation(fields: [academyId], references: [id])
  currentTutorId Int
  currentTutor   Tutor   @relation(fields: [currentTutorId], references: [id])

  tutorHourlyRate     Float?
  studentSessionPrice Float?
  active              Boolean @default(true)

  members  GroupStudent[]
  sessions Session[]

  chatRoom GroupChatRoom?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([currentTutorId])
  @@index([academyId])
}

model GroupStudent {
  id                 Int     @id @default(autoincrement())
  groupId            Int
  group              Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId          Int
  student            Student @relation(fields: [studentId], references: [id])
  customSessionPrice Float?

  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  active   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, studentId])
  @@index([groupId])
  @@index([studentId])

  subscriptions Subscription[]
}

// ===================Plans (standalone products) ==================

model Plan {
  id            Int    @id @default(autoincrement())
  title         String
  sessionCount  Int
  price         Float  @default(0)
  billingPeriod Int    @default(30)

  currencyId Int
  currency   Currency @relation(fields: [currencyId], references: [id])
  academyId  Int
  academy    Academy  @relation(fields: [academyId], references: [id])

  revenues Revenue[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===================Session and Attendance=================
model Session {
  id              Int      @id @default(autoincrement())
  startTime       DateTime
  durationMinutes Int      @default(60)
  topic           String?
  notes           String?
  isTrial         Boolean  @default(false)
  cancelledBy     Int?

  zoomUrl String?

  groupId Int
  group   Group @relation(fields: [groupId], references: [id])

  tutorId   Int
  tutor     Tutor @relation(fields: [tutorId], references: [id])
  tutorRate Float

  supervisorId Int
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id])

  academyId Int
  academy   Academy @relation(fields: [academyId], references: [id])

  participants    SessionParticipant[]
  assignment      Assignment?
  tutorAttendance TutorAttendance?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([supervisorId])
  @@index([isTrial])
  @@index([tutorId])
  @@index([startTime])
}

model SessionParticipant {
  id        Int     @id @default(autoincrement())
  sessionId Int
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  studentAttendanceStatus Int?
  reason                  String?
  cancelledBy             Int?

  price         Float @default(0) // price frozen at scheduling
  paymentStatus Int   @default(0)

  report            SessionReport?
  homeworkSolutions HomeworkSolution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

// Supervisor's review of the tutor's own attendance/conduct for a session.
model TutorAttendance {
  id        Int     @id @default(autoincrement())
  sessionId Int     @unique
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  status Int
  notes  String?

  // Who set the status: 0 = auto (created from tutor activity), 1 = supervisor review.
  source Int @default(0)

  reviewedBy Int
  supervisor Supervisor @relation(fields: [reviewedBy], references: [id])
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([reviewedBy])
}

model TutorAvailability {
  id        Int      @id @default(autoincrement())
  tutorId   Int
  tutor     Tutor    @relation(fields: [tutorId], references: [id])
  dayOfWeek Int
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentAvailability {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  dayOfWeek Int
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id         Int    @id @default(autoincrement())
  content    String
  targetType Int
  targetId   Int
  authorId   Int
  author     User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tutor     Tutor?   @relation(fields: [tutorId], references: [id])
  tutorId   Int?
  student   Student? @relation(fields: [studentId], references: [id])
  studentId Int?

  @@index([targetType, targetId])
  @@index([authorId])
}

model SessionReport {
  id            Int                @id @default(autoincrement())
  participantId Int                @unique
  participant   SessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  rating     Int?
  outcomes   String?
  strengths  String?
  weaknesses String?
  nextGoals  String?
  comments   String?
  details    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId])
}

// ===================Finances=================

model Revenue {
  id          Int      @id @default(autoincrement())
  amount      Float
  currencyId  Int
  currency    Currency @relation(fields: [currencyId], references: [id])
  status      Int      @default(0)
  method      Int?
  dueDate     DateTime @default(now())
  description String?
  channel     String?
  notes       String?
  invoiceUrl  String?

  academyId  Int
  academy    Academy @relation(fields: [academyId], references: [id])
  studentId  Int
  student    Student @relation(fields: [studentId], references: [id])
  planId     Int?
  plan       Plan?   @relation(fields: [planId], references: [id])
  subscriptionId Int?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  recordedBy Int?
  recorder   User?   @relation(fields: [recordedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([subscriptionId])
}

// A commercial agreement for a student's enrollment in a specific group.
// One GroupStudent can have multiple Subscription rows over time (renewals
// expire the previous row and create a new one) so pricing history is preserved.
model Subscription {
  id             Int          @id @default(autoincrement())
  groupStudentId Int
  groupStudent   GroupStudent @relation(fields: [groupStudentId], references: [id], onDelete: Cascade)

  planId Int?
  plan   Plan?    @relation(fields: [planId], references: [id])

  price        Float // agreed price for one billing cycle (authoritative)
  currencyId   Int
  currency     Currency @relation(fields: [currencyId], references: [id])

  sessionCount    Int?     // sessions included per billing cycle (fallback: plan.sessionCount)
  billingCycle    Int      @default(30) // days between billing dates
  startDate       DateTime
  endDate         DateTime? // current cycle end / expiry
  nextBillingDate DateTime? // next expected payment date

  status Int @default(0) // SubscriptionStatus: active/cancelled/expired/pending

  payments Revenue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupStudentId])
  @@index([planId])
  @@index([status])
}

model Expense {
  id          Int      @id @default(autoincrement())
  date        DateTime
  description String
  amount      Float
  currencyId  Int
  currency    Currency @relation(fields: [currencyId], references: [id])
  method      Int?
  status      Int      @default(0)
  invoiceUrl  String?
  notes       String?

  tutorId     Int?
  tutor       Tutor?  @relation(fields: [tutorId], references: [id])
  salaryMonth String?

  academyId    Int
  academy      Academy     @relation(fields: [academyId], references: [id])
  recordedBy   Int?
  user         User?       @relation(fields: [recordedBy], references: [id])
  costCenterId Int?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academyId])
  @@index([tutorId])
  @@index([date])
}

// ===================Meta Data=================

model History {
  id           Int     @id @default(autoincrement())
  targetType   Int
  targetId     Int
  action       Int
  changes      Json?
  metadata     Json?
  recordedBy   Int
  recorderType Int
  academyId    Int
  academy      Academy @relation(fields: [academyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([action])
  @@index([academyId])
}

model Lead {
  id                  String   @id @default(cuid())
  fullName            String
  phone               String
  academyName         String
  countryCode         String?
  studentCategory     String?
  teacherCount        String?
  currentMethod       String?
  biggestChallenge    String?
  urgency             String?
  qualificationTier   String?
  qualificationStatus String?
  whatsappMessageId   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  whatsAppMessages WhatsAppMessage[]

  @@index([qualificationTier])
  @@index([qualificationStatus])
}

model WhatsAppMessage {
  id           String    @id @default(cuid())
  academyId    Int
  academy      Academy   @relation(fields: [academyId], references: [id])
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id])
  messageId    String?
  remoteJid    String
  type         String
  content      String?
  status       String
  sentAt       DateTime  @default(now())
  deliveredAt  DateTime?
  readAt       DateTime?
  errorMessage String?

  @@index([academyId])
  @@index([leadId])
}

model CostCenter {
  id    Int    @id @default(autoincrement())
  title String

  expenses Expense[]

  createdAt DateTime @default(now())
}

model ChatRoom {
  id            Int     @id @default(autoincrement())
  tutorUserId   Int
  tutor         User    @relation(fields: [tutorUserId], references: [id], name: "TutorChatRooms")
  studentUserId Int
  student       User    @relation(fields: [studentUserId], references: [id], name: "StudentChatRooms")
  isClosed      Boolean @default(false)
  academyId     Int
  academy       Academy @relation(fields: [academyId], references: [id])

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tutorUserId, studentUserId])
  @@index([tutorUserId, studentUserId])
  @@index([academyId])
}

model ChatMessage {
  id        Int       @id @default(autoincrement())
  roomId    Int
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User      @relation(fields: [senderId], references: [id])
  content   String
  isRead    Boolean   @default(false)
  isDeleted Boolean   @default(false)
  readAt    DateTime?
  refId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@index([senderId])
}

// ===================Group Chat ==================

model GroupChatRoom {
  id        Int     @id @default(autoincrement())
  groupId   Int     @unique
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  academyId Int
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  members  GroupChatMember[]
  messages GroupChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academyId])
}

model GroupChatMember {
  id               Int            @id @default(autoincrement())
  roomId           Int
  room             GroupChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId           Int
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt         DateTime       @default(now())
  leftAt           DateTime?
  active           Boolean        @default(true)
  lastReadMessageId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, userId])
  @@index([userId])
}

model GroupChatMessage {
  id        Int     @id @default(autoincrement())
  roomId    Int
  room      GroupChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  isRead    Boolean @default(false)
  isDeleted Boolean @default(false)
  readAt    DateTime?
  refId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@index([senderId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// =================== Homework / Assignment ==================

model Assignment {
  id        Int     @id @default(autoincrement())
  sessionId Int     @unique
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  title       String?
  description String?
  deadline    DateTime?
  maxScore    Int       @default(10)

  filePath         String
  originalFileName String
  fileSize         Int
  mimeType         String

  solutions HomeworkSolution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeworkSolution {
  id            Int                @id @default(autoincrement())
  assignmentId  Int
  assignment    Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  participantId Int
  participant   SessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  filePath         String
  originalFileName String
  fileSize         Int
  mimeType         String

  score    Int?
  feedback String?

  submittedAt DateTime  @default(now())
  gradedAt    DateTime?
  gradedBy    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, participantId])
}
